# Public site origin. Set to your temporary Vercel URL until you buy the domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase: create a project, run sql/schema.sql, then add these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI is optional. Keep keys server-side only; never expose in NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# All outreach/lead features are OFF until reviewed and intentionally enabled.
ENABLE_CONTACT_SUBMISSIONS=false
ENABLE_CHATBOT=false
ENABLE_WHATSAPP=false
ENABLE_NEWSLETTER=false
ENABLE_PUSH_NOTIFICATIONS=false

# Set only after a verified office address is approved for publication.
PUBLIC_OFFICE_ADDRESS=
