NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Supabase Project > Connect: Project URL and Publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Enable only after legal/privacy review, credentials and testing.
ENABLE_CONTACT_SUBMISSIONS=false
ENABLE_CHATBOT=false
ENABLE_WHATSAPP=false
ENABLE_NEWSLETTER=false
ENABLE_PUSH_NOTIFICATIONS=false

# Vercel Cron: use a long random secret. Configure verified official RSS/Atom feed URLs only.
CRON_SECRET=
LEGAL_SOURCE_FEEDS=
